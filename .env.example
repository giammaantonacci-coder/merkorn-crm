# Collegamento al progetto Supabase — Impostazioni > API
# L'applicazione e interamente server-side: il prefisso NEXT_PUBLIC_ non e
# necessario, e vanno bene anche i nomi senza prefisso che imposta da se
# l'integrazione Vercel <-> Supabase.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Necessaria. Supabase > Impostazioni > API > service_role.
# Serve a tre cose: registrare una persona al primo ingresso, suggerire i nomi
# gia usati, e fare da segreto per la credenziale interna. Non deve mai finire
# nel codice ne raggiungere il browser: resta solo fra le variabili d'ambiente.
SUPABASE_SERVICE_ROLE_KEY=

# PIN uguale per tutta la squadra, chiesto insieme al nome.
# Se lo si lascia vuoto, per entrare basta il nome.
ACCESSO_PIN=

# Facoltativa: se valorizzata sostituisce la chiave di servizio come segreto
# per derivare le credenziali interne. Cambiarla obbliga tutti a rientrare.
# ACCESSO_SEGRETO=
