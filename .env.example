# Collegamento al progetto Supabase — Impostazioni > API
# L'applicazione e interamente server-side: il prefisso NEXT_PUBLIC_ non e
# necessario, e vanno bene anche i nomi senza prefisso che imposta da se
# l'integrazione Vercel <-> Supabase.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Necessaria: l'accesso col solo nome registra la persona al primo ingresso.
# L'integrazione Vercel <-> Supabase la imposta da se.
SUPABASE_SERVICE_ROLE_KEY=

# Facoltativo. Se valorizzato, oltre al nome viene chiesto questo PIN,
# uguale per tutta la squadra. Serve a impedire che chiunque abbia il link
# entri semplicemente scrivendo un nome.
# ACCESSO_PIN=
